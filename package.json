{
  "name": "scimkit",
  "version": "0.1.0",
  "description": "SCIM 2.0 provisioning for Node.js and NestJS: let Okta, Microsoft Entra ID and any SCIM client create, update and deactivate users and groups in your app.",
  "keywords": [
    "scim",
    "scim2",
    "provisioning",
    "directory-sync",
    "okta",
    "entra",
    "azure-ad",
    "sso",
    "enterprise",
    "b2b",
    "nestjs",
    "postgres",
    "rfc7643",
    "rfc7644"
  ],
  "homepage": "https://github.com/Bekhruz/scimkit#readme",
  "bugs": {
    "url": "https://github.com/Bekhruz/scimkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bekhruz/scimkit.git"
  },
  "license": "MIT",
  "author": "Bekhruz (https://github.com/Bekhruz)",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./postgres": {
      "import": {
        "types": "./dist/postgres.d.ts",
        "default": "./dist/postgres.js"
      },
      "require": {
        "types": "./dist/postgres.d.cts",
        "default": "./dist/postgres.cjs"
      }
    },
    "./nestjs": {
      "import": {
        "types": "./dist/nestjs.d.ts",
        "default": "./dist/nestjs.js"
      },
      "require": {
        "types": "./dist/nestjs.d.cts",
        "default": "./dist/nestjs.cjs"
      }
    },
    "./verify": {
      "import": {
        "types": "./dist/verify.d.ts",
        "default": "./dist/verify.js"
      },
      "require": {
        "types": "./dist/verify.d.cts",
        "default": "./dist/verify.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "bin": {
    "scimkit": "./dist/cli.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run test/unit",
    "test:integration": "vitest run test/integration examples",
    "test:coverage": "vitest run --coverage",
    "db:start": "node scripts/postgres.mjs start",
    "db:stop": "node scripts/postgres.mjs stop",
    "pack:check": "node scripts/pack-check.mjs",
    "audit:deps": "node scripts/audit-deps.mjs",
    "ci": "node scripts/ci.mjs",
    "ci:fast": "node scripts/ci.mjs --fast",
    "ci:matrix": "node scripts/matrix.mjs",
    "version:bump": "node scripts/bump.mjs",
    "release": "node scripts/release.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "prepublishOnly": "node scripts/prepublish.mjs"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "pg": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "10.0.1",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/platform-fastify": "12.1.3",
    "@nestjs/testing": "12.1.3",
    "@swc/core": "1.16.18",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "express": "5.2.1",
    "globals": "17.13.0",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild"
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
